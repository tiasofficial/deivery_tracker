{
  "expo": {
    "name": "DeliveryTrack",
    "slug": "delivery-tracker",
    "version": "1.0.0",
    "scheme": "deliverytrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deliverytrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F0F1A"
      },
      "package": "com.deliverytrack.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59beb423-7fba-431d-90a3-19a5defbd07d"
      }
    },
    "owner": "arpitjainofficial"
  }
}
