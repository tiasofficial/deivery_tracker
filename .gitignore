# Master gitignore for project root

# Ignore node_modules everywhere
**/node_modules/

# Ignore environment variables/secrets
**/.env
**/.env.local
**/.env.production
**/.env.development

# Ignore Expo bundler cache & local builds
**/.expo/
**/web-build/
**/android/build/
**/ios/build/

# Ignore TypeScript build output
**/dist/
**/build/

# System files
**/.DS_Store
Thumbs.db
